---
import '../css/common/footer.css'
---

<footer>
	<div class="footer-body">

		<!-- Brand + socials -->
		<section class="footer-brand">
			<a href="/"><img src="/resources/assets/render2.svg" alt="Lumynity Studios" class="footer-logo"></a>
			<div class="footer-socials">
				<a href="https://google.com" class="footer-social-link" aria-label="Discord">
					<img src="/resources/assets/discord.svg" alt="Discord">
				</a>
				<a href="https://google.com" class="footer-social-link" aria-label="GitHub">
					<img src="/resources/assets/github.svg" alt="GitHub">
				</a>
				<a href="https://google.com" class="footer-social-link" aria-label="Twitter">
					<img src="/resources/assets/twitter.svg" alt="Twitter">
				</a>
				<a href="https://google.com" class="footer-social-link" aria-label="Bluesky">
					<img src="/resources/assets/bluesky.svg" alt="Bluesky">
				</a>
				<a href="mailto:lumynitystudios@gmail.com" class="footer-social-link" aria-label="Email">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
						<rect x="2" y="4" width="20" height="16" rx="2"/>
					</svg>
				</a>
			</div>
		</section>

		<!-- Link columns -->
		<section class="footer-cols">
			<div class="footer-col">
				<span class="footer-col-title">About</span>
				<a href="/news">News</a>
				<a href="https://google.com">Careers</a>
			</div>
			<div class="footer-col">
				<span class="footer-col-title">Resources</span>
				<a href="https://google.com">Support</a>
				<a href="https://google.com">Developer Docs</a>
			</div>
		</section>

	</div>

	<!-- Disclaimer bar -->
	<div class="footer-bar">
		Lumynity Studios is not an official Minecraft service, not affiliated, associated with or approved by Mojang Studios or Microsoft.
	</div>
</footer>

